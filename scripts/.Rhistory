devtools::install_github("jbisanz/qiime2R")
library(tidyverse)
library(qiime2R)
library(ggplot2)
library(RColorBrewer)
############################
##Unweighted-Unifrac Plots##
############################
#Import qiime2 data and metadata
#Change file paths to location and names of your files
total_SVs <- read_qza("/Users/sulhasan/Desktop/UPRM_QIIME2workshop/data/R_input/PCoA/rarefied_table.qza")
total_RPCA <- read_qza("/Users/sulhasan/Desktop/UPRM_QIIME2workshop/data/R_input/PCoA/unweighted_unifrac_pcoa_results.qza")
total_metadata <- read_csv("/Users/sulhasan/Desktop/UPRM_QIIME2workshop/data/R_input/PCoA/rarefied_metadata.csv")
#Save PCoA data as a data frame
pcoa_df <- total_RPCA$data$Vectors
#Check for correct SampleIDs and check header
head(total_RPCA)
#Link metadata to PCoA data
merged_data <- merge(pcoa_df, total_metadata, by = "SampleID")
#Modify the color variable to metadata column of interest
#Unweighted-Unifrac Sample Type PCoA
ggplot(merged_data, aes(x = PC1, y = PC2, color = Sample_Type)) +
geom_point(size = 3) +
stat_ellipse(level = 0.95) +
theme_minimal() +
labs(x = paste0("PC1 (", round(total_RPCA$data$ProportionExplained[1] * 100, 2), "%)"),
y = paste0("PC2 (", round(total_RPCA$data$ProportionExplained[2] * 100, 2), "%)"),
title = "Unweighted PCoA Plot") +
theme(axis.text = element_text(size = 12), axis.title = element_text(size = 14))
#Unweighted-Unifrac Primer PCoA
ggplot(merged_data, aes(x = PC1, y = PC2, color = Primer)) +
geom_point(size = 3) +
stat_ellipse(level = 0.95) +
scale_color_brewer(palette = "Dark2") +
theme_minimal() +
labs(x = paste0("PC1 (", round(total_RPCA$data$ProportionExplained[1] * 100, 2), "%)"),
y = paste0("PC2 (", round(total_RPCA$data$ProportionExplained[2] * 100, 2), "%)"),
title = "Unweighted PCoA Plot") +
theme(axis.text = element_text(size = 12), axis.title = element_text(size = 14))
##Weighted-Unifrac Primer PCoA
ggplot(merged_data, aes(x = PC1, y = PC2, color = Primer)) +
geom_point(size = 3) +
stat_ellipse(level = 0.95) +
scale_color_brewer(palette = "Dark2") +
theme_minimal() +
labs(x = paste0("PC1 (", round(total_RPCA$data$ProportionExplained[1] * 100, 2), "%)"),
y = paste0("PC2 (", round(total_RPCA$data$ProportionExplained[2] * 100, 2), "%)"),
title = "Weighted PCoA Plot") +
theme(axis.text = element_text(size = 12), axis.title = element_text(size = 14))
